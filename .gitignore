# --- Downloaded / built assets (managed by update-firecracker.sh) ---
# Kernels, rootfs images, and the extracted squashfs tree are all fetched or
# built at runtime and never committed.
vmlinux-*
!vmlinux-latest
ubuntu-*.ext4
ubuntu-*.squashfs
ubuntu-*.squashfs.upstream
# SSH keys (private + public) — generated by update-firecracker.sh, never committed
ubuntu-*.id_rsa
ubuntu-*.id_rsa.pub
squashfs-root/

# Symlinks to the "latest" assets — created by update-firecracker.sh, but keep
# the symlink names themselves out of the repo too since their targets are
# gitignored and vary per machine.
vmlinux-latest
ubuntu-latest.ext4
ubuntu-latest.id_rsa

# --- Secrets: the dedicated guest SSH keypair (generated, never committed) ---
guest.id_rsa
guest.id_rsa.pub
id_rsa
id_rsa.pub

# --- Runtime logs and per-VM state ---
fc.log
fc-vm*.log
*.log

# --- The unpacked release bundle if someone ran the binary download here ---
release-v*/

# --- Editor / OS cruft ---
.DS_Store
*.swp
*.swo
*~
