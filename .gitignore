# --- Downloaded / built assets (managed by update-firecracker.sh) ---
# Kernels, rootfs images, and the extracted squashfs tree are all fetched or
# built at runtime and never committed.
vmlinux-*
ubuntu-*.ext4
ubuntu-*.squashfs
ubuntu-*.squashfs.upstream
# SSH keys (private + public) — generated by update-firecracker.sh, never committed
ubuntu-*.id_rsa
ubuntu-*.id_rsa.pub
squashfs-root/
# Per-VM writable bytes built by start-vm.sh (overlay layer / whole-image
# copy) and the overlay-root initrd. 'ubuntu-*.ext4' above does not cover
# these names.
vm[0-9]*-layer.ext4
vm[0-9]*.ext4
initrd-overlay.img
# transient hardlink staging copy the agent step builds the ext4 from
.agent-stage*

# Symlinks to the "latest" assets — created by update-firecracker.sh, but keep
# the symlink names themselves out of the repo too since their targets are
# gitignored and vary per machine.
vmlinux-latest
ubuntu-latest.ext4
ubuntu-latest.id_rsa

# --- Secrets: the dedicated guest SSH keypair (generated, never committed) ---
guest.id_rsa
guest.id_rsa.pub
id_rsa
id_rsa.pub
# Per-VM guest SSH keys generated by start-vm.sh ('guest.id_rsa*' above does
# not match these — the dash matters).
guest-vm*.id_rsa
guest-vm*.id_rsa.pub

# --- Secrets: Anthropic platform credentials minted by auth-login.sh (ant) ---
# Contains live refresh tokens for the guest-dedicated 'fc-agents' profile.
# Never commit; never scp into a VM (share it over NFS instead — one copy only,
# because refresh tokens rotate on renewal).
anthropic-config/

# --- Claude Code session transcripts, shared out of the guest's /root/.claude ---
# Holds full session content (prompts, file contents, tool output) — treat as
# sensitive even though it isn't a credential.
claude-sessions/

# --- Runtime logs and per-VM state ---
fc.log
fc-vm*.log
*.log

# --- The unpacked release bundle if someone ran the binary download here ---
release-v*/

# --- Editor / OS cruft ---
.DS_Store
*.swp
*.swo
*~

# --- Trust-on-first-use SSH host keys for the guests (regenerated per image) ---
.known_hosts

# --- Marker: firewalld intra-zone forwarding was enabled by start-vm.sh ---
# stop-vm.sh reads this to know the relaxation is ours to undo.
.fw-forward-added
# Marker: the egress allowlist in force for this host (see fc_egress_state_file)
.fc-egress-policy

# NOTE: image-pins.lock is deliberately NOT ignored. It records the sha256 of
# artifacts that publish no checksum of their own (the CI kernel/rootfs and the
# Claude Code installer), so a later fetch can be checked against it.
